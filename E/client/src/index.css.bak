@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{--ink:#123f45;--deep:#0d4f4b;--muted:#789198;--line:#e2eeee;--bg:#f1f8f6;--white:#fff;--green:#087a68;--green-dark:#075f55;--mint:#e4f5ef;--gold:#c7a04a;--blue:#347fe4;--purple:#8063d9;--orange:#e4a33c;--red:#e26969;--shadow:0 3px 16px rgba(22,72,75,.045)}
*{box-sizing:border-box}html,body,#root{min-height:100%;margin:0}body{font-family:Inter,system-ui,sans-serif;color:var(--ink);background:#fff;font-size:12px}button,input,select,textarea{font:inherit}button{cursor:pointer}
.app-shell{min-height:100vh;display:flex;background:linear-gradient(135deg,#f9fdfc 0%,#eef7f5 65%,#eaf5f2 100%);position:relative;overflow-x:hidden}.app-shell:before{content:"";position:fixed;right:-115px;top:-100px;width:570px;height:260px;border-radius:50%;border:9px solid rgba(200,160,72,.44);border-left-color:transparent;border-bottom-color:transparent;transform:rotate(-12deg);pointer-events:none}.app-shell:after{content:"";position:fixed;left:-115px;bottom:-125px;width:450px;height:225px;border-radius:50%;border:12px solid rgba(198,160,72,.34);border-right-color:transparent;border-top-color:transparent;transform:rotate(8deg);pointer-events:none}
.sidebar{width:17.8vw;min-width:205px;max-width:250px;position:fixed;inset:0 auto 0 0;background:rgba(247,252,250,.9);border-right:1px solid #e0ecea;padding:13px 10px 11px;z-index:30;display:flex;flex-direction:column}.side-brand{display:flex;align-items:center;justify-content:center;min-height:67px;margin-bottom:5px}.brand{width:100%;display:flex;justify-content:center}.brand-logo-img{width:calc(100% - 14px);max-width:155px;height:auto;object-fit:contain;display:block}.sidebar nav{display:flex;flex-direction:column;gap:2px}.sidebar nav a{display:flex;align-items:center;gap:11px;color:#4f6a70;text-decoration:none;font-size:11px;font-weight:600;padding:9px 10px;border-radius:8px;min-height:32px}.sidebar nav a svg{flex:0 0 auto}.sidebar nav a:hover{background:#edf7f4}.sidebar nav a.active{background:linear-gradient(90deg,#0b7766,#087a68);color:#fff;box-shadow:0 4px 9px rgba(8,122,104,.11)}.side-footer{margin-top:auto;color:#9aabad;font-size:8px;padding:10px 9px 2px;line-height:1.55}.side-footer span{font-size:6px;letter-spacing:.08em;color:#b6c3c2}.mobile-close,.mobile-menu,.overlay{display:none}
.main{margin-left:17.8vw;min-width:0;flex:1;position:relative;z-index:1}.topbar{height:51px;border-bottom:1px solid #e0ecea;background:rgba(255,255,255,.74);display:flex;align-items:center;padding:0 18px;gap:16px;position:sticky;top:0;z-index:20}.global-search{height:30px;width:325px;border-radius:18px;background:#f0f6f6;display:flex;align-items:center;gap:8px;padding:0 11px;color:#547279}.global-search input{border:0;outline:0;background:transparent;width:100%;font-size:9px;color:var(--ink)}.global-search input::placeholder{color:#9aacb0}.top-actions{margin-left:auto;display:flex;align-items:center;gap:8px}.icon-btn{width:30px;height:30px;border-radius:50%;border:1px solid #dfeae9;background:#fff;color:#345e63;display:grid;place-items:center;position:relative}.icon-btn i{position:absolute;right:6px;top:5px;width:5px;height:5px;border-radius:50%;background:#e06666}.avatar{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#0c7c68;color:#fff;font-size:10px;font-weight:700}.user{line-height:1.2}.user b{display:block;font-size:9px}.user span{display:block;color:#8ba0a4;font-size:8px;margin-top:2px}.chev{font-size:13px;color:#6e8388;margin-left:3px}
.content{padding:14px 18px 24px;max-width:1300px;margin:0 auto}.eyebrow{font-size:8px;font-weight:800;letter-spacing:.23em;color:#087764;text-transform:uppercase;margin-bottom:4px}.page-header{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin:0 0 13px}.page-header h1,.dash-head h1{margin:0;color:#0c4650;font-size:21px;line-height:1.1;letter-spacing:-.035em}.page-header p,.dash-head p{margin:4px 0 0;color:#789198;font-size:9px}.header-actions{display:flex;align-items:center;gap:7px}.primary{border:0;background:#087764;color:#fff;border-radius:7px;padding:8px 12px;display:inline-flex;align-items:center;gap:6px;font-size:9px;font-weight:700;white-space:nowrap;box-shadow:0 3px 8px rgba(8,119,100,.1)}.primary:hover{background:#076d5d}.secondary{border:1px solid #dce8e6;background:#fff;color:#46666c;border-radius:7px;padding:7px 10px;display:inline-flex;align-items:center;gap:5px;font-size:9px;font-weight:600}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:12px}.stat-card{background:rgba(255,255,255,.92);border:1px solid #e1eceb;border-radius:9px;min-width:0;min-height:76px;padding:12px 11px;display:flex;align-items:flex-start;gap:9px;box-shadow:var(--shadow)}.stat-icon{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto}.stat-icon.green{background:#e5f6ef;color:#087764}.stat-icon.blue{background:#e6efff;color:#347fe4}.stat-icon.purple{background:#f0eaff;color:#8063d9}.stat-icon.orange{background:#fff2dc;color:#d39222}.stat-icon.red{background:#ffe9e7;color:#df6464}.stat-copy{min-width:0;display:flex;flex-direction:column}.stat-copy span{font-size:8px;color:#5f777d;font-weight:600}.stat-copy strong{font-size:18px;line-height:1;margin-top:6px;color:#133f47;letter-spacing:-.03em}.stat-copy small{font-size:7px;color:#8da0a4;margin-top:5px}.stat-arrow{margin-left:auto;color:#879da1;font-size:17px;line-height:1}.panel{background:rgba(255,255,255,.88);border:1px solid #e1eceb;border-radius:9px;box-shadow:var(--shadow)}
.toolbar{display:flex;align-items:center;gap:7px;padding:9px 10px;border-bottom:1px solid #edf3f2}.search-box{height:31px;border:1px solid #e3eceb;border-radius:7px;background:#fff;display:flex;align-items:center;gap:7px;padding:0 9px;color:#6e858a;flex:1;min-width:190px}.search-box input{border:0;outline:0;width:100%;font-size:8px;color:var(--ink)}.select{height:31px;border:1px solid #e3eceb;border-radius:7px;background:#fff;color:#587178;font-size:8px;padding:0 9px;min-width:105px;outline:none}.reset{height:31px;border:1px solid #e3eceb;border-radius:7px;background:#fff;color:#587178;padding:0 10px;display:flex;align-items:center;gap:5px;font-size:8px;font-weight:600}.table-wrap{overflow:auto}.data-table{width:100%;border-collapse:collapse;min-width:900px}.data-table th{background:#f7fbfa;color:#6f858a;font-size:7px;text-align:left;font-weight:600;padding:8px 8px;white-space:nowrap;border-bottom:1px solid #edf2f2}.data-table td{padding:7px 8px;border-top:1px solid #edf2f2;color:#536f76;font-size:7.5px;white-space:nowrap;vertical-align:middle}.data-table td strong{color:#214d54;font-size:7.7px}.data-table tbody tr:hover{background:#fcfefe}.row-check{width:11px;height:11px;accent-color:#087764}.name-cell,.customer-cell{display:flex;align-items:center;gap:7px}.initial{width:21px;height:21px;border-radius:50%;display:grid;place-items:center;background:#e4f2f8;color:#347ba2;font-weight:700;font-size:8px;flex:0 0 auto}.country{display:flex;align-items:center;gap:5px}.sub{display:block;color:#96a7aa;font-size:6.5px;margin-top:2px}.status{display:inline-flex;align-items:center;padding:3px 6px;border-radius:999px;font-size:6.5px;font-weight:700;background:#edf3f2;color:#5c7378}.status.active,.status.paid,.status.completed,.status.confirmed,.status.delivered,.status.in-stock{background:#ddf4e9;color:#138060}.status.pending,.status.partially-paid,.status.preparing,.status.sent,.status.low-stock{background:#fff0d5;color:#bf7d16}.status.unpaid,.status.overdue{background:#ffe2e0;color:#c65353}.status.in-transit,.status.shipped,.status.open{background:#e1efff;color:#347ac8}.status.quotation{background:#ece5ff;color:#7458c9}.status.sales-order{background:#dff5ec;color:#138060}.status.enquiry{background:#ece6ff;color:#7558c8}.actions{display:flex;gap:4px}.small-btn{width:23px;height:23px;border:1px solid #e0eaea;background:#fff;border-radius:6px;display:grid;place-items:center;color:#5b747a}.pagination{display:flex;justify-content:space-between;align-items:center;padding:8px 10px;color:#8a9da1;font-size:7px}.pages{display:flex;gap:4px}.pages button{width:22px;height:22px;border:1px solid #e0eaea;background:#fff;border-radius:6px;color:#587178;font-size:8px}.pages button.active{background:#087764;color:#fff;border-color:#087764}
.dash-head{display:flex;justify-content:space-between;align-items:flex-end;position:relative;min-height:72px;margin:0 -18px 11px;padding:10px 18px 8px;background:linear-gradient(145deg,rgba(239,248,246,.72),rgba(255,255,255,.18));overflow:hidden}.dash-head:after{content:"";position:absolute;right:-65px;top:-95px;width:430px;height:185px;border-radius:50%;border:7px solid rgba(200,160,72,.4);border-left-color:transparent;border-bottom-color:transparent;transform:rotate(-16deg);pointer-events:none}.welcome{font-size:8px;font-weight:700;color:#0a5051;margin-bottom:2px}.dash-head h1{font-size:23px;position:relative;z-index:1}.dash-head p{position:relative;z-index:1}.date-control{height:30px;border:0;background:transparent;color:#526f75;display:flex;align-items:center;gap:6px;font-size:8px;z-index:2}.date-control span{margin-left:2px}.dashboard-main-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(185px,.75fr);gap:10px}.section-title{display:flex;align-items:center;justify-content:space-between;padding:10px 11px 7px}.section-title h3{margin:0;font-size:10px;color:#163f47}.section-title a{font-size:7.5px;color:#087764;font-weight:700;text-decoration:none}.dash-table{min-width:650px}.quick-list{padding:0 11px 7px}.quick-list a{display:flex;align-items:center;gap:8px;text-decoration:none;color:#46666c;font-size:8px;padding:9px 2px;border-top:1px solid #edf2f2}.quick-list a:first-child{border-top:0}.quick-list a svg{color:#087764}.quick-list a span{margin-left:auto;font-size:13px;color:#81969a}.bottom-stats{margin-top:11px;margin-bottom:0}.bottom-stats .stat-card{min-height:67px}.bottom-stats .stat-copy strong{font-size:16px}
.row-icon{width:23px;height:23px;border-radius:50%;display:grid;place-items:center;flex:0 0 auto}.row-icon.green{background:#e5f6ef;color:#087764}.row-icon.orange{background:#fff1db;color:#d39222}.row-icon.blue{background:#e7efff;color:#347fe4}.mode-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 6px;border-radius:999px;background:#e5efff;color:#347fe4;font-size:6.5px}.mode-badge svg{flex:0 0 auto}.table-panel{overflow:hidden}.module-stats{margin-bottom:11px}
.reports-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px;margin-bottom:10px}.chart-card{padding:9px 10px;height:183px}.chart-card h3{margin:0 0 3px;font-size:9px;color:#17444b}.chart-head{display:flex;justify-content:space-between;align-items:center}.chart-head select{border:1px solid #e1eceb;background:#fff;border-radius:6px;font-size:7px;color:#637b80;padding:4px}.recent-reports{overflow:hidden}.recent-reports .section-title{padding-bottom:5px}
.settings-grid{display:grid;grid-template-columns:205px minmax(0,1fr);gap:11px}.settings-menu{padding:7px}.setting-link{display:flex;align-items:center;gap:8px;padding:9px 7px;border-radius:7px;color:#4f6b72}.setting-link.active{background:#e6f6f0}.setting-icon{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#e4f5ef;color:#087764;flex:0 0 auto}.setting-link:nth-child(2) .setting-icon{background:#e9f1f8;color:#3474a5}.setting-link:nth-child(3) .setting-icon{background:#eee8ff;color:#805fd6}.setting-link:nth-child(4) .setting-icon{background:#fff2dc;color:#db9223}.setting-link:nth-child(5) .setting-icon{background:#e8edff;color:#6d6fd5}.setting-link:nth-child(6) .setting-icon{background:#e8ebf5;color:#5d678e}.setting-link:nth-child(7) .setting-icon{background:#e4f6f7;color:#3c9aa2}.setting-link:nth-child(8) .setting-icon{background:#fff0d9;color:#d98b20}.setting-link b{display:block;font-size:8px}.setting-link small{display:block;font-size:6.5px;color:#8da0a4;margin-top:2px}.setting-arrow{margin-left:auto;font-size:13px;color:#819599}.settings-stack{display:flex;flex-direction:column;gap:10px}.setting-card{padding:10px 12px}.setting-head{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid #edf2f2;padding-bottom:8px;margin-bottom:8px}.setting-head h3{display:flex;align-items:center;gap:6px;margin:0;font-size:9px;color:#183f46}.setting-head h3 svg{color:#087764}.setting-head>div>span{display:block;font-size:6.5px;color:#8ba0a4;margin-top:3px}.profile-line{display:grid;grid-template-columns:60px 1fr 1.3fr 1.2fr 1.3fr;gap:13px;align-items:center}.big-avatar{width:46px;height:46px;border-radius:50%;background:#087764;color:#fff;display:grid;place-items:center;font-size:14px;font-weight:700}.detail label,.business-grid label{display:block;color:#83979b;font-size:6px;margin-bottom:4px}.detail b,.business-grid b{display:block;color:#365a61;font-size:7.5px;font-weight:600;line-height:1.5}.mini-tag{font-size:6px;background:#e0f4e9;color:#138060;padding:2px 5px;border-radius:999px;margin-left:3px}.business-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.business-grid>div{display:grid;grid-template-columns:1fr;gap:0}.business-grid label{margin-top:5px}.pref-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.pref-grid label{display:block;font-size:6px;color:#7f9498;margin-bottom:4px}.pref-grid input{width:100%;height:27px;border:1px solid #e0eaea;border-radius:6px;padding:0 8px;color:#48656b;font-size:7px;background:#fff}
.modal-backdrop{position:fixed;inset:0;background:rgba(10,45,46,.28);z-index:100;display:grid;place-items:center;padding:18px}.modal{width:min(680px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:10px;border:1px solid #e1eceb;box-shadow:0 20px 50px rgba(10,45,46,.16)}.modal-head{padding:15px 16px;border-bottom:1px solid #edf2f2}.modal-head h2{margin:0;font-size:18px}.modal-body{padding:15px}.modal-foot{display:flex;justify-content:flex-end;gap:7px;padding:10px 15px;border-top:1px solid #edf2f2}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.field{display:flex;flex-direction:column;gap:4px}.field.full{grid-column:1/-1}.field label{font-size:8px;font-weight:700;color:#5c767b}.field input,.field textarea,.field select{border:1px solid #dfeaea;border-radius:7px;outline:none;padding:8px;font-size:9px;color:#365a61;background:#fff}.field textarea{min-height:75px;resize:vertical}.loading{padding:50px;text-align:center;color:#7c9095}
@media(max-width:1050px){.sidebar{min-width:185px}.main{margin-left:185px}.content{padding:12px}.dashboard-main-grid{grid-template-columns:1fr}.quick-card{display:none}.settings-grid{grid-template-columns:185px 1fr}.reports-grid{grid-template-columns:1fr 1fr}.profile-line{grid-template-columns:55px 1fr 1fr}.profile-line .detail:nth-child(4),.profile-line .detail:nth-child(5){display:none}}
@media(max-width:760px){.sidebar{transform:translateX(-100%);transition:.22s;width:230px;max-width:230px}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.mobile-menu{display:grid;place-items:center;width:30px;height:30px;border:1px solid #e0eaea;background:#fff;border-radius:7px;color:#45666d}.mobile-close{display:block;border:0;background:transparent;color:#557178;margin-left:auto}.overlay{display:block;position:fixed;inset:0;background:rgba(0,0,0,.18);z-index:25}.topbar{padding:0 10px}.global-search{width:auto;flex:1}.user,.chev{display:none}.content{padding:10px}.page-header{align-items:flex-start}.page-header h1{font-size:18px}.page-header p{font-size:8px}.stats{grid-template-columns:1fr 1fr}.dash-head{margin:0 -10px 9px;padding:10px}.dash-head h1{font-size:20px}.date-control{display:none}.module-stats{grid-template-columns:1fr 1fr}.toolbar{flex-wrap:wrap}.search-box{min-width:100%}.select{flex:1;min-width:90px}.settings-grid{grid-template-columns:1fr}.settings-menu{display:grid;grid-template-columns:1fr 1fr}.setting-link{padding:7px}.profile-line{grid-template-columns:55px 1fr}.profile-line .detail:nth-child(n+3){display:block}.business-grid,.pref-grid{grid-template-columns:1fr 1fr}.reports-grid{grid-template-columns:1fr}.chart-card{height:180px}.form-grid{grid-template-columns:1fr}.data-table{min-width:920px}}
