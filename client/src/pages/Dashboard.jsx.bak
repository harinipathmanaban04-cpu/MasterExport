import React,{useEffect,useState}from'react';
import{ArrowUpRight,ClipboardList,Users,Package,Ship,FileText,ReceiptText,CalendarDays}from'lucide-react';
import{get}from'../api';import{StatCard,Status}from'../components/Layout';
const flag={UAE:'🇦🇪',Germany:'🇩🇪',Singapore:'🇸🇬',USA:'🇺🇸','Netherlands':'🇳🇱',China:'🇨🇳',Japan:'🇯🇵'};
export default function Dashboard(){const[d,setD]=useState(null);useEffect(()=>get('/dashboard').then(setD).catch(()=>setD({recentSales:[]})),[]);if(!d)return <div className="loading">Loading dashboard…</div>;
return <>
 <div className="dash-head"><div><div className="welcome">Welcome back,</div><h1>Good Morning, John!</h1><p>Here’s what’s happening with your export business today.</p></div><button className="date-control"><CalendarDays size={13}/> Apr 23, 2025 <span>⌄</span></button></div>
 <div className="stats dash-stats"><StatCard icon={ClipboardList} label="Active Orders" value="24" note="↑ 12% vs last week"/><StatCard icon={Ship} label="Pending Shipments" value="8" note="3 due within 48h" tone="orange"/><StatCard icon={FileText} label="Outstanding Payments" value="$45,000" note="↑ 2 invoices overdue" tone="red"/><StatCard icon={ArrowUpRight} label="Monthly Sales" value="$185,000" note="↑ 8% vs last month" tone="blue"/></div>
 <div className="dashboard-main-grid"><section className="panel"><div className="section-title"><h3>Recent Sales Orders</h3><a href="/sales">View all</a></div><div className="table-wrap"><table className="data-table dash-table"><thead><tr><th>ORDER NO.</th><th>CUSTOMER</th><th>DESTINATION</th><th>STAGE</th><th>AMOUNT</th><th>STATUS</th></tr></thead><tbody>{d.recentSales.slice(0,5).map((x,i)=><tr key={x._id||i}><td><strong>{x.orderNo||x.quotationNo||x.enquiryNo}</strong></td><td>{x.customer}</td><td>{x.destination}</td><td><Status>{x.type}</Status></td><td>${Number(x.totalAmount||0).toLocaleString()}</td><td><Status>{x.status}</Status></td></tr>)}</tbody></table></div></section>
 <section className="panel quick-card"><div className="section-title"><h3>Quick Actions</h3></div><div className="quick-list"><a href="/sales"><ReceiptText size={15}/>Create New Enquiry <span>›</span></a><a href="/customers"><Users size={15}/>Add Customer <span>›</span></a><a href="/products"><Package size={15}/>Add Product <span>›</span></a><a href="/sales"><ClipboardList size={15}/>Create Sales Order <span>›</span></a></div></section></div>
 <div className="stats bottom-stats"><StatCard icon={Users} label="Total Customers" value="12" note="Active customers"/><StatCard icon={Package} label="Total Products" value="35" note="In catalog" tone="orange"/><StatCard icon={Ship} label="Total Shipments" value="6" note="In transit" tone="blue"/><StatCard icon={FileText} label="Total Invoices" value="18" note="$32,500 issued" tone="purple"/></div>
 </>}
